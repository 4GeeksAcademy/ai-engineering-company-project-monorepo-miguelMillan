#!/usr/bin/env bash
# Único comando con sudo del usuario de operaciones. Acciones y servicios cerrados; nada de shell ni de rutas libres.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
cd /opt/trackflow/app
SERVICES=" interfaces backend mcp redis qdrant celery-worker flower "
compose() { docker compose --project-directory /opt/trackflow/app --env-file /etc/trackflow/trackflow.env "$@"; }
service() { [[ $# -eq 1 && "$1" =~ ^[a-z-]+$ && "$SERVICES" == *" $1 "* ]] || { echo "servicio no permitido" >&2; exit 2; }; }
usage() { echo "uso: trackflow-ctl status | up | logs <servicio> | restart <servicio> | accounts <list|set-role|set-clients> …" >&2; exit 2; }

action="${1:-}"; shift || true
logger -t trackflow-ctl "usuario=${SUDO_USER:-root} accion=${action//[^a-z-]/_} args=${*//[^A-Za-z0-9@._ -]/_}" 2>/dev/null || true
case "$action" in
  status)  [[ $# -eq 0 ]] || usage; compose ps ;;
  up)      [[ $# -eq 0 ]] || usage; compose up -d ;;
  logs)    service "$@"; compose logs --no-color --tail 500 "$1" ;;
  restart) service "$@"; compose restart "$1" ;;
  accounts) compose exec -T backend python accounts.py "$@" ;;
  *) usage ;;
esac
