# Install in the service user's crontab after replacing paths and setting DB URLs.
# Runs daily at 02:15 local time; TARGET_DATE is still resolved in UTC by the script.
15 2 * * * cd /ruta/al/monorepo && /ruta/al/monorepo/services/api/.venv/bin/python scripts/nightly_export.py >> /ruta/al/monorepo/nightly-export.log 2>&1
